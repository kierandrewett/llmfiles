# Docker Compose interpolation values. Copy to .env and edit local paths.
OPENCODE_VERSION=1.0.180
OPENCODE_BRIDGE_IMAGE=opencode-messaging-bridge:local
OPENCODE_BRIDGE_CONTAINER_NAME=opencode-bridge
# Surface command: telegram, discord, or telegram+discord.
OPENCODE_BRIDGE_COMMAND=discord
OPENCODE_BRIDGE_RUNTIME_ENV_FILE=${HOME}/.config/opencode-messaging-bridge/env
OPENCODE_BRIDGE_AUTH_DIR=${HOME}/.local/share/opencode
OPENCODE_BRIDGE_CONFIG_DIR=${HOME}/.config/opencode-messaging-bridge/opencode-config
OPENCODE_BRIDGE_PROJECT_DIR=${HOME}/dev/bsociety
OPENCODE_BRIDGE_OPENCODE_PORT=4096
