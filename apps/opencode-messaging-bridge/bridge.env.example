# Runtime bridge settings. Copy this file outside the repo and keep the real copy untracked.

# Telegram daemon settings. Keep these for OPENCODE_BRIDGE_COMMAND=telegram or telegram+discord.
# Remove these if OPENCODE_BRIDGE_COMMAND=discord.
OPENCODE_BRIDGE_TELEGRAM_BOT_TOKEN=123456789:replace-with-real-token
OPENCODE_BRIDGE_TELEGRAM_ALLOWED_USER_IDS=123456789
OPENCODE_BRIDGE_TELEGRAM_ALLOWED_CHAT_IDS=123456789
OPENCODE_BRIDGE_TELEGRAM_CREATE_TOPICS=0

# Discord daemon settings. Keep these for OPENCODE_BRIDGE_COMMAND=discord or telegram+discord.
# Remove these if OPENCODE_BRIDGE_COMMAND=telegram.
OPENCODE_BRIDGE_DISCORD_BOT_TOKEN=replace-with-real-token
OPENCODE_BRIDGE_DISCORD_CONTROL_CHANNEL_ID=123456789012345678
OPENCODE_BRIDGE_DISCORD_ALLOWED_USER_IDS=123456789012345678
OPENCODE_BRIDGE_DISCORD_APPLICATION_ID=123456789012345678
OPENCODE_BRIDGE_DISCORD_GUILD_ID=123456789012345678
OPENCODE_BRIDGE_DISCORD_REGISTER_SLASH_COMMANDS=1
OPENCODE_BRIDGE_DISCORD_SLASH_COMMAND=oc
OPENCODE_BRIDGE_DISCORD_PREFIX=!oc
OPENCODE_BRIDGE_DISCORD_SLASH_EPHEMERAL=1
OPENCODE_BRIDGE_DISCORD_MESSAGE_CONTENT_INTENT=0
OPENCODE_BRIDGE_IMPLICIT_REPLY=0

# Optional OpenRouter voice transcription. Leave disabled unless you want audio prompts.
OPENCODE_BRIDGE_VOICE_TRANSCRIPTION=0
OPENCODE_BRIDGE_OPENROUTER_API_KEY=
OPENCODE_BRIDGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_BRIDGE_OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENCODE_BRIDGE_OPENROUTER_TRANSCRIPTION_LANGUAGE=
OPENCODE_BRIDGE_VOICE_MAX_AUDIO_BYTES=20971520
